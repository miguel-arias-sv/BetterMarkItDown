# Copy this file to .env and fill in your own key. .env is gitignored.
#
#   cp .env.example .env
#
# Get a key at https://aistudio.google.com/apikey
# The tool reads GEMINI_API_KEY first, then GOOGLE_API_KEY, then the
# environment. It never writes a key to disk and never prints one.

GEMINI_API_KEY=your-key-here

# Optional: override the default model for every run.
# BMID_MODEL=gemini-3.6-flash
