# Copy this file to .env and fill in your own key. .env is gitignored.
#
#   cp .env.example .env
#
# Simpler and safer: `bettermarkitdown key set gemini` saves the key in your
# computer's password store, with no file at all. A real environment variable
# beats this file, and this file beats the password store.
# The tool never prints a key in full.
#
# Each provider reads only its own variable, so a key never goes to another company.

# Google Gemini (the default). Get a key, free tier included: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Other providers - uncomment the one you use, and pick it with --provider or BMID_PROVIDER.
# OPENAI_API_KEY=        # --provider openai      https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=     # --provider anthropic   https://console.anthropic.com/settings/keys
# MOONSHOT_API_KEY=      # --provider kimi        https://platform.kimi.ai
# OPENROUTER_API_KEY=    # --provider openrouter  https://openrouter.ai/keys
# BMID_PROVIDER=gemini

# Optional: override the provider's default model for every run.
# BMID_MODEL=gemini-3.6-flash

# Optional: a different OpenAI-compatible endpoint for every run. A local endpoint
# needs no key at all.
#
#   BMID_BASE_URL=http://localhost:11434/v1     # Ollama
#   BMID_BASE_URL=http://localhost:1234/v1      # LM Studio (key, if any: BMID_API_KEY)
