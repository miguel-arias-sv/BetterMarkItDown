# Copy this file to .env and fill in your own key. .env is gitignored.
#
#   cp .env.example .env
#
# The tool reads GEMINI_API_KEY, then GOOGLE_API_KEY, then OPENAI_API_KEY.
# A real environment variable always wins over this file, so you can keep the
# key in your user environment and have no secret in the repo at all.
# It never writes a key to disk and never prints one in full.
#
# Get a Gemini key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your-key-here

# Optional: override the default model for every run.
# BMID_MODEL=gemini-3.6-flash

# Optional: use a different OpenAI-compatible endpoint for every run.
# A local endpoint needs no key at all - leave GEMINI_API_KEY empty and the tool
# sends a placeholder, because the openai client insists on a non-empty string.
#
#   BMID_BASE_URL=http://localhost:11434/v1     # Ollama
#   BMID_BASE_URL=https://api.openai.com/v1     # OpenAI
#   BMID_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter
